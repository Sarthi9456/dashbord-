<div class="auth-wrapper">
  <div class="auth-card">
    <h1>Forgot password</h1>
    <p class="subtitle">We'll generate a reset link for your account</p>

    <% if (typeof error !== 'undefined' && error && error.length) { %>
      <div class="alert alert-error"><%= error[0] %></div>
    <% } %>

    <% if (typeof infoMessage !== 'undefined' && infoMessage) { %>
      <div class="alert alert-success"><%= infoMessage %></div>
    <% } %>

    <% if (typeof resetLink !== 'undefined' && resetLink) { %>
      <div class="reset-link-box">
        <a href="<%= resetLink %>"><%= resetLink %></a>
        <div class="reset-link-note">
          This link expires in 30 minutes. In a production app this would be emailed to you instead
          of shown on screen — it's displayed here because no outbound email service is configured
          for this demo.
        </div>
      </div>
    <% } else { %>
      <form action="/forgot-password" method="POST">
        <div class="form-group">
          <label>Email</label>
          <input type="email" name="email" required autofocus placeholder="you@example.com" />
        </div>
        <button type="submit" class="btn btn-primary" style="width:100%;">Send reset link</button>
      </form>
    <% } %>

    <p style="text-align:center; margin-top:16px; font-size:13px;">
      <a href="/login" class="forgot-link">Back to login</a>
    </p>
  </div>
</div>
